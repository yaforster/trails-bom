<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.yaforster</groupId>
    <artifactId>trails-bom</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <name>Trails BOM</name>
    <description>Tested version alignment for Trails SDK and official adapters.</description>
    <url>https://github.com/yaforster/trails-bom</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yaforster</id>
            <name>Yannick Forster</name>
            <url>https://github.com/yaforster</url>
            <roles><role>maintainer</role></roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yaforster/trails-bom.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yaforster/trails-bom.git</developerConnection>
        <url>https://github.com/yaforster/trails-bom</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/yaforster/trails-bom/issues</url>
    </issueManagement>
    <properties>
        <trails.version>0.0.1</trails.version>
        <selenium-bom.version>4.44.0</selenium-bom.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-bom</artifactId>
                <version>${selenium-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.yaforster</groupId>
                <artifactId>trails-sdk</artifactId>
                <version>${trails.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yaforster</groupId>
                <artifactId>trails-adapter-mysql</artifactId>
                <version>${trails.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yaforster</groupId>
                <artifactId>trails-adapter-selenium-grid</artifactId>
                <version>${trails.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yaforster</groupId>
                <artifactId>trails-adapter-webdriver-support</artifactId>
                <version>${trails.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yaforster</groupId>
                <artifactId>trails-adapter-local-webdriver</artifactId>
                <version>${trails.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yaforster</groupId>
                <artifactId>trails-notifier-smtp</artifactId>
                <version>${trails.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yaforster</groupId>
                <artifactId>trails-adapter-oidc-jwt</artifactId>
                <version>${trails.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <passphraseServerId>gpg.passphrase</passphraseServerId>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
